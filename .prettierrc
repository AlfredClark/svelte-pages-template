{
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSameLine": false,
  "trailingComma": "none",
  "printWidth": 100,
  "plugins": [
    "prettier-plugin-svelte",
    "prettier-plugin-tailwindcss",
    "prettier-plugin-packagejson"
  ],
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": "*.svg", "options": { "parser": "html" } }
  ]
}
